# Stage 1: Build the Flutter application
FROM ghcr.io/cirruslabs/flutter:stable AS builder

# Set working directory
WORKDIR /app

# Copy pubspec.yaml and pubspec.lock
COPY pubspec.yaml pubspec.lock ./

# Install dependencies
RUN flutter pub get

# Copy the rest of the application
COPY . .

# Build the application with the correct entry point
RUN flutter build web --release -t lib/app/main.dart

# Stage 2: Serve the application with NGINX
FROM nginx:alpine

# Copy the built application to nginx
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy a Linux-specific nginx configuration
COPY nginx.linux.conf /etc/nginx/conf.d/default.conf

# Add curl for healthcheck (Alpine-specific)
RUN apk add --no-cache curl

# Create directories for logs
RUN mkdir -p /var/log/nginx

# Set proper permissions
RUN chmod -R 755 /usr/share/nginx/html

# Expose port
EXPOSE 3000

# Healthcheck to verify the service is running
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"] 